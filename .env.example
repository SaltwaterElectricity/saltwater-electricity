# --- PROJECT ENVIRONMENT VARIABLES TEMPLATE ---
# 1. Copy this file and rename it to ".env"
# 2. Fill in the values below with your actual credentials.
# 3. DO NOT commit the actual ".env" file to GitHub.

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project_id.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Firebase Admin (Backend Only - DO NOT use VITE_ prefix)
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SendGrid Configuration (For Notifications/OTP)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=your_verified_sender_email@example.com


# System Roles & Company Contact
VITE_SUPER_ADMIN_EMAIL=admin@example.com
VITE_COMPANY_EMAIL=support@example.com

# Private SMS Gateway (Master Device UID)
# The UID of the Android device that will act as the centralized SMS sender for the entire system.
MASTER_GATEWAY_UID=your_user_uid_here